# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 密钥与环境变量（ADR：API Key 加密主密钥，丢失即无法解密已存密钥）
.env
.env.*
!.env.example
.secret_key

# 运行时数据：SQLite 演示库与 Chroma 本地持久化目录
*.db
*.sqlite
*.sqlite3
data/
storage/

# Node / 前端构建产物
node_modules/
dist/
.vite/
*.local

# 编辑器与系统
.DS_Store

# 视觉回归截图：只入库 v1-old（改造前冻结参照），其余为运行产物
# 注意：含斜杠的模式锚定 .gitignore 所在目录，必须写全 frontend/ 前缀
frontend/tests/screenshots/*
!frontend/tests/screenshots/v1-old/
playwright-report/
.idea/
.vscode/
*.swp

# 工具产物：由 `uipro init --ai codebuddy` 生成（约 4.8MB），可重现，不入库
.codebuddy/
